    "i = 1\n",
    "sum_even = 0\n",
    "\n",
    "while i <= 15:\n",
    "    if i % 2 == 0:\n",
    "        sum_even = sum_even + i\n",
    "    i = i + 1\n",
    "\n",
    "print(\"Сумма чётных чисел:\", sum_even)"

   ],
   "source": [
    "array = [7, 3, 8, 1, 4, 6, 2, 5]\n",
    "n = len(array)\n",
    "\n",
    "for i in range(n):\n",
    "    for j in range(0, n - 1):\n",
    "        if array[j] > array[j + 1]:\n",
    "            temp = array[j]\n",
    "            array[j] = array[j + 1]\n",
    "            array[j + 1] = temp\n",
    "\n",
    "print(\"Отсортированный массив:\", array)"
   ]

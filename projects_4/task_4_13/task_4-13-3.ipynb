   "source": [
    "N = int(input(\"Введите целое неотрицательное число N: \"))\n",
    "\n",
    "if N < 0:\n",
    "    print(\"Ошибка: Факториал не определён для отрицательных чисел!\")\n",
    "else:\n",
    "    \n",
    "    F = 1\n",
    "    i = 1\n",
    "    \n",
    "    while i <= N:\n",
    "        F = F * i\n",
    "        i = i + 1\n",
    "    \n",
    "    print(f\"{N}! = {F}\")"
   ]
  }
 ],

   "outputs": [],
   "source": [
    "N = int(input(\"Введите количество натуральных чисел N: \"))\n",
    "\n",
    "if N < 1:\n",
    "    print(\"Ошибка: N должно быть ≥ 1!\")\n",
    "else:\n",
    "    S = 0\n",
    "    i = 1\n",
    "    \n",
    "    while i <= N:\n",
    "        S = S + i\n",
    "        i = i + 1\n",
    "    \n",
    "    print(f\"Сумма первых {N} натуральных чисел: {S}\")"
   ]
  }
 ],

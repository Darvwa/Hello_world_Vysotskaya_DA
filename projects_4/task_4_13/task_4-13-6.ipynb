     "text": [
      "Введите количество чисел N:  7\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Сумма квадратов первых 7 чисел: 140\n"
     ]
    }
   ],
   "source": [
    "N = int(input(\"Введите количество чисел N: \"))\n",
    "\n",
    "if N < 1:\n",
    "    print(\"Ошибка: N должно быть ≥ 1!\")\n",
    "else:\n",
    "    S = 0\n",
    "    i = 1\n",
    "    \n",
    "    while i <= N:\n",
    "        S = S + i * i\n",
    "        i = i + 1\n",
    "    \n",
    "    print(f\"Сумма квадратов первых {N} чисел: {S}\")"
   ]
  },
